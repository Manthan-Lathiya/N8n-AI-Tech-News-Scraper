    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst allArticles = [];\n\nfor (const item of items) {\n  const articles = item.json.rss?.channel?.item || [];\n  for (const article of articles) {\n    allArticles.push({ json: article });\n  }\n}\n\nreturn allArticles;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        729
      ],
      "id": "9a349c2a-7133-4b23-bfa8-374777067ba9",
      "name": "Process_ExtractArticles"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst keywords = [\n  \"ai\",\n  \"artificial intelligence\",\n  \"machine learning\",\n  \"automation\",\n  \"ai product\",\n  \"ai tool\",\n  \"tech innovation\",\n  \"ai safety\",\n  \"ai regulation\",\n  \"ai ethics\",\n  \"openai\",\n  \"google\",\n  \"meta\",\n  \"microsoft\"\n];\n\nfunction isRelevant(article) {\n  const text = `${article.title || \"\"} ${article.description || \"\"}`.toLowerCase();\n  return keywords.some(keyword => text.includes(keyword));\n}\n\nlet bestArticle = null;\n\nfor (const item of items) {\n  const article = item.json;\n  if (isRelevant(article)) {\n    bestArticle = article;\n    break; // Pick the first relevant one\n  }\n}\n\nif (bestArticle) {\n  return [\n    {\n      json: {\n        title: bestArticle.title,\n        link: bestArticle.link,\n        description: bestArticle.description\n      }\n    }\n  ];\n} else {\n  return []; // or return a fallback message if no match\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        720
      ],
      "id": "b805f045-4285-42e6-aef4-6300fc4610f7",
      "name": "Process_SelectOneArticle"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You're a tech journalist for a Telegram news bot.\n\nWrite a catchy, engaging, exciting post based on this article. Structure it like this:\n\n🧠 Title: [Make it punchy and surprising]\n📌 Summary: [One short paragraph in human language—what’s cool or unexpected?]\n🔗 Link: give the link\n📣 Tags: (3–5 good tags according to article) #SnapFeedNow\n\nDon't be boring. Write like it's for a viral Telegram audience.\n\nInputs:\ntitle:{{ $json.title }}\nDescription:{{ $json.description }}\nlink : {{ $json.link }}\n\n",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        1100,
        604
      ],
      "id": "febfca33-2240-4873-b039-8985292e795c",
      "name": "Process_SummarizeArticle"
